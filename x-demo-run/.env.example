# x-demo-run settings. Copy to .env next to this file and adjust for the machine.
# .env is not committed; .env.example is.

# Base folder for run reports. Inside it the report goes to the task folder:
# an existing "<KEY>-*", otherwise a new "<KEY>".
# A relative path is counted from the working-tree root (git rev-parse --show-toplevel);
# an absolute path is used as it is. No ~ and no shell variables: the value is read with grep.
XDEMO_RUN_DIR=.forge/tasks

# Language of the report text (titles, actions, expected results, captions, notes),
# e.g. ru, en. Empty — the language of the conversation.
XDEMO_RUN_REPORT_LANG=
