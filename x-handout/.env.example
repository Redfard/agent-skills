# Handout config. Copy to .env next to this file and adjust for the machine.
# .env is not committed to git, .env.example is.

# Base directory for files the person opens themselves.
# Absolute path, no ~ and no shell variables: the value is read with grep,
# not expanded by the shell, and "~/tmp/handout" would create a directory named "~".
# Keep it OUTSIDE working trees: the artifact will not show up in git status and will survive a branch switch.
XHANDOUT_DIR=/root/tmp/handout
